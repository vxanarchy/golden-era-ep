    <script>
        const lenis = new Lenis();
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);

        let count = 0;
        const counterElement = document.querySelector('.loader-pct');
        const loader = document.getElementById('loader');

        const interval = setInterval(() => {
            count += Math.floor(Math.random() * 8) + 1;
            if (count >= 100) {
                count = 100;
                clearInterval(interval);
                gsap.to(loader, {
                    opacity: 0,
                    duration: 1,
                    onComplete: () => {
                        loader.style.display = 'none';
                    }
                });
            }
            counterElement.innerText = count + '%';
        }, 80);

        function openTrack(id) {}

        function closeTrack() {
            document.getElementById('track-modal').classList.remove('active');
            lenis.start();
        }

        document.getElementById('track-modal').addEventListener('click', function(e) {
            if (e.target === this) closeTrack();
        });

        let lastScrollTop = 0;
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            let scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            if (scrollTop > lastScrollTop && scrollTop > 100) navbar.classList.add('hidden');
            else navbar.classList.remove('hidden');
            lastScrollTop = scrollTop;
        });

        let isPlaying = false;
        function togglePlayState() {
            const btn = document.getElementById('playBtn');
            const frame = document.getElementById('spotifyPlayer');
            isPlaying = !isPlaying;
            btn.innerText = isPlaying ? "⏸" : "▶";
            if (frame) frame.style.opacity = isPlaying ? "1" : "0";
        }

        function togglePlayerMinimize() {
            document.getElementById('floatPlayer').classList.toggle('minimized');
        }

        const heroSection = document.getElementById('hero');
        const bgImg = document.querySelector('.hero-bg-image');
        heroSection.addEventListener('mousemove', (e) => {
            const { clientX, clientY } = e;
            const xVal = (clientX / window.innerWidth - 0.5) * 15;
            const yVal = (clientY / window.innerHeight - 0.5) * 15;
            gsap.to(bgImg, { x: xVal, y: yVal, duration: 1, ease: "power2.out" });
        });
    </script>
